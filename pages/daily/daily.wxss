.daily-page {
  position: relative;
  overflow: hidden;
  background: #F7F3EA;
}

.daily-page::before {
  position: absolute;
  top: -72rpx;
  right: -64rpx;
  z-index: 0;
  width: 210rpx;
  height: 210rpx;
  border: 1rpx solid #263D2E;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 25%, #263D2E 0 8%, #F7F3EA 9% 25%, transparent 26%),
    radial-gradient(circle at 50% 75%, #F7F3EA 0 8%, #263D2E 9% 25%, transparent 26%),
    linear-gradient(90deg, #F7F3EA 0 50%, #263D2E 50% 100%);
  content: "";
  opacity: 0.06;
  pointer-events: none;
}

.daily-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 0 32rpx;
}

.daily-title {
  color: #263D2E;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.daily-subtitle {
  margin-top: 8rpx;
  color: rgba(38, 61, 46, 0.58);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
}

.today-chip {
  flex: 0 0 auto;
  margin-top: 4rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(38, 61, 46, 0.08);
  border-radius: 999rpx;
  color: rgba(38, 61, 46, 0.58);
  background: #FFFDF7;
  font-size: 23rpx;
}

.sign-paper,
.today-status-card,
.calendar-panel {
  box-sizing: border-box;
  border: 1rpx solid rgba(38, 61, 46, 0.08);
  border-radius: 28rpx;
  background: #FFFDF7;
  box-shadow: 0 10rpx 28rpx rgba(38, 61, 46, 0.04);
}

.sign-paper {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
}

.sign-label {
  position: relative;
  z-index: 1;
  color: #9A463C;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 26rpx;
  line-height: 1.4;
}

.sign-title {
  margin-top: 14rpx;
  color: #263D2E;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.45;
}

.sign-line {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: rgba(38, 61, 46, 0.82);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.8;
}

.feel-btn {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin: 28rpx 0 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #4F6F52;
  font-size: 30rpx;
  line-height: 1.2;
}

.feel-btn.felt {
  color: #9A463C;
  border: 1rpx solid rgba(154, 70, 60, 0.22);
  background: rgba(154, 70, 60, 0.08);
}

.today-status-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
}

.status-dot {
  flex: 0 0 auto;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(38, 61, 46, 0.2);
}

.today-status-card.done .status-dot {
  background: #9A463C;
}

.status-copy {
  min-width: 0;
}

.status-title {
  color: #263D2E;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.45;
}

.status-text {
  margin-top: 4rpx;
  color: rgba(38, 61, 46, 0.58);
  font-size: 26rpx;
  line-height: 1.55;
}

.section-row {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
}

.month-summary {
  margin-top: -8rpx;
  color: rgba(38, 61, 46, 0.58);
  font-size: 26rpx;
  line-height: 1.6;
}

.calendar-panel {
  position: relative;
  z-index: 1;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 32rpx;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.calendar-month {
  color: #263D2E;
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}

.month-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  border: 1rpx solid rgba(38, 61, 46, 0.08);
  border-radius: 999rpx;
  color: #263D2E;
  background: #F7F3EA;
  font-size: 34rpx;
  line-height: 1.2;
}

.week-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.week-row {
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(38, 61, 46, 0.06);
  color: rgba(38, 61, 46, 0.52);
  font-size: 25rpx;
  text-align: center;
}

.week-label {
  height: 34rpx;
  line-height: 34rpx;
}

.day-cell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  color: rgba(38, 61, 46, 0.72);
  font-size: 29rpx;
  font-weight: 400;
}

.day-cell.empty {
  visibility: hidden;
}

.day-text {
  position: relative;
  z-index: 1;
}

.day-cell.checked .day-text {
  color: #ffffff;
  font-weight: 500;
}

.day-cell.checked::before {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #9A463C;
  content: "";
}
