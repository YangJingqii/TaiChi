.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(38, 61, 46, 0.08);
  overflow: hidden;
  background: #F7F3EA;
  box-shadow: 0 -8rpx 26rpx rgba(38, 61, 46, 0.04);
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 82rpx;
  border-radius: 999rpx;
  color: rgba(38, 61, 46, 0.56);
}

.tab-item.active {
  color: #263D2E;
  background: rgba(221, 232, 216, 0.56);
}

.tab-icon {
  position: relative;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
}

.tab-icon.daily {
  width: 42rpx;
  height: 34rpx;
  border: 3rpx solid currentColor;
  border-radius: 7rpx;
  background: transparent;
}

.tab-icon.daily::before {
  position: absolute;
  top: 5rpx;
  bottom: 5rpx;
  left: 18rpx;
  width: 3rpx;
  height: auto;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
  opacity: 0.55;
}

.tab-icon.daily::after {
  position: absolute;
  top: 8rpx;
  right: 6rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.tab-icon.album {
  width: 46rpx;
  height: 34rpx;
  margin-top: 4rpx;
  border: 3rpx solid currentColor;
  border-radius: 9rpx;
  transform: none;
}

.tab-icon.album::before {
  position: absolute;
  top: -12rpx;
  left: 8rpx;
  width: 18rpx;
  height: 10rpx;
  box-sizing: border-box;
  border-radius: 6rpx 6rpx 0 0;
  background: currentColor;
  content: "";
}

.tab-icon.album::after {
  position: absolute;
  top: 7rpx;
  left: 13rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  background: transparent;
  content: "";
}

.tab-icon.me::before {
  position: absolute;
  top: 3rpx;
  left: 11rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.tab-icon.me::after {
  position: absolute;
  right: 5rpx;
  bottom: 2rpx;
  left: 5rpx;
  height: 20rpx;
  border-radius: 20rpx 20rpx 7rpx 7rpx;
  background: currentColor;
  content: "";
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}
