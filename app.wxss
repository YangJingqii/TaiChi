page {
  min-height: 100vh;
  color: #263D2E;
  background: #F7F3EA;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 30rpx;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font: inherit;
  line-height: 1.2;
  min-width: 0;
  padding: 0;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 170rpx;
}

.section-title {
  margin: 40rpx 0 20rpx;
  color: #263D2E;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.muted {
  color: rgba(38, 61, 46, 0.56);
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #4F6F52;
  font-size: 30rpx;
  line-height: 1.2;
}

.secondary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 1rpx solid rgba(38, 61, 46, 0.14);
  border-radius: 999rpx;
  color: #4F6F52;
  background: #FFFDF7;
  font-size: 30rpx;
  line-height: 1.2;
}
